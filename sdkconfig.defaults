CONFIG_IDF_TARGET="esp32c6"

# Control loop model and FreeRTOS scheduling run at 1 kHz (Ts = 1 ms).
CONFIG_FREERTOS_HZ=1000

# GPIO12/13 (USB D-/D+ no ESP32-C6) sao usados como RPWM/LPWM da ponte H:
# USB-Serial-JTAG desligado, console somente na UART0.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_USJ_ENABLE_USB_SERIAL_JTAG is not set
